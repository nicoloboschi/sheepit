<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>


        <!-- StatusBar.setBackgroundColor() is a no-op from Android 15 on, so
             the bars have to be coloured from the theme or they render as a
             bright white strip above the terminal. #0c0c0c matches the UI
             background (and the `backgroundColor` in capacitor.config.ts). -->
        <item name="android:statusBarColor">#0c0c0c</item>
        <item name="android:navigationBarColor">#0c0c0c</item>
        <!-- Dark bars, so the clock and gesture pill draw in light glyphs. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>

        <!-- Whatever shows through before/around the WebView should be the
             terminal background, never the DayNight default (#fafafa in light
             mode, which flashed white on launch). -->
        <item name="android:windowBackground">#0c0c0c</item>
        <item name="android:colorBackground">#0c0c0c</item>
    </style>


    <!-- This is the theme named in AndroidManifest.xml, so it is what the
         window is actually created with. BridgeActivity swaps in
         AppTheme.NoActionBar afterwards, but a post-creation setTheme() does
         not reliably re-apply window bar attributes — so the bar colours have
         to be repeated here, or the status bar renders as a white strip above
         the terminal. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">#0c0c0c</item>
        <item name="android:navigationBarColor">#0c0c0c</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>
</resources>