<?xml version="1.0" encoding="utf-8"?>
<!--
  Notification small icon: the SheepIcon glyph from
  ui/src/components/SheepIcon.tsx — a terminal window wearing a fleece.

  Android draws notification small icons as a silhouette — only the alpha
  channel survives, and the system tints it (iconColor in capacitor.config.ts).
  Everything here is therefore opaque white; the shapes, not the colours, are
  what matter. The glyph is inset slightly from the 24dp edge so it does not
  collide with the status bar's own padding.
-->
