        android:translateX="1.2"
        android:translateY="1.25"
        android:scaleX="0.9"
        android:scaleY="0.9">

        <path
            android:pathData="M4.6,10.3a2.7,2.7 0 1,1 2.9,-4.1a2.7,2.7 0 0,1 4.4,-1.2a2.7,2.7 0 0,1 4.6,1.2a2.7,2.7 0 0,1 2.9,4.1"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />

        <path
            android:pathData="M6.8,9.6h10.4a2.2,2.2 0 0,1 2.2,2.2v3.2a2.2,2.2 0 0,1 -2.2,2.2h-10.4a2.2,2.2 0 0,1 -2.2,-2.2v-3.2a2.2,2.2 0 0,1 2.2,-2.2z"
