<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon background: the sheepit pasture gradient
  (#9cbc7f meadow -> #6fa98c moss, 135deg) from CLAUDE.md.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0.0" android:color="#FF9CBC7F" />
                <item android:offset="1.0" android:color="#FF6FA98C" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
