{
  "name": "vipershell",
  "version": "1.0.0",
  "description": "Your machine, anywhere — a full-featured terminal in your browser. No tmux required.",
  "type": "module",
  "license": "MIT",
  "author": "Nicolò Boschi",
  "homepage": "https://github.com/nicoloboschi/vipershell#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicoloboschi/vipershell.git"
  },
  "bugs": {
    "url": "https://github.com/nicoloboschi/vipershell/issues"
  },
  "keywords": [
    "terminal",
    "browser",
    "pty",
    "shell",
    "xterm",
    "tmux",
    "web-terminal",
    "remote"
  ],
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "vipershell": "./dist/index.js"
  },
  "files": [
    "dist",
    "ui/dist",
    "scripts/postinstall.sh"
  ],
  "scripts": {
    "build": "tsc && npm run build:ui",
    "build:ui": "cd ui && npm run build",
    "dev": "bash dev.sh",
    "start": "node dist/index.js",
    "postinstall": "sh scripts/postinstall.sh",
    "prepack": "npm run build",
    "test": "vitest run",
    "release": "bash release.sh"
  },
  "dependencies": {
    "@vectorize-io/hindsight-client": "^0.4.21",
    "@vscode/ripgrep": "^1.17.1",
    "commander": "^12.0.0",
    "express": "^4.19.0",
    "node-pty": "^1.0.0",
    "react-syntax-highlighter": "^16.1.1",
    "systeminformation": "^5.22.0",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^1.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.0"
  }
}
